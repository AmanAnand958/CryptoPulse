# ============================================================
# CryptoPulse RL — Backend Environment Variables (.env)
# Copy this file to `.env` and fill in your API keys.
# ============================================================

# --- LLM API Keys (at least one required for signal generation) ---

# Groq (free tier: llama-3.1-8b-instant, llama-3.3-70b-versatile)
# Get yours: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_API_KEY_2=gsk_your_second_groq_api_key_here  # optional fallback

# Google Gemini (free tier: 20 req/day for gemini-2.5-flash)
# Get yours: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# NVIDIA NIM (free tier: Llama 3.3 70B Instruct)
# Get yours: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here

# --- Market Data API Keys ---

# Bright Data (Phase 1 live data source — web scraping MCP)
# Get yours: https://brightdata.com
BRIGHT_DATA_API_KEY=your_bright_data_api_key_here

# Alpha Vantage (news sentiment API — free tier: 25 req/day)
# Get yours: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# --- Optional: LangSmith Tracing ---
# LANGCHAIN_API_KEY=your_langsmith_api_key
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=CryptoPulse-RL
